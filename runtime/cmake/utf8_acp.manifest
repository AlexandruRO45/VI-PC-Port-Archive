<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Makes the program's active code page UTF-8, so a narrow path it is built with (the LEONIDA_TEST_* macros are UTF-8 string literals, from /utf-8) names the same file the program opens. Without it a build folder with a non-ASCII character is read in the ANSI code page and the file is not found (TEST-1982). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
