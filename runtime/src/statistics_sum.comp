#version 450

// One invocation sums one 64-bit counter across segments. Row zero holds the running totals.
layout(local_size_x = 11) in;
layout(set = 0, binding = 0, std430) buffer QueryResults {
    uvec2 words[];
};
layout(push_constant) uniform ResolveRange { uint count; uint counters; };

void main() {
    const uint counter = gl_LocalInvocationID.x;
    if (counter >= counters) return;
    uvec2 sum = words[counter];
    for (uint i = 0; i < count; ++i) {
        uvec2 segment = words[(i + 1) * counters + counter];
        uint low = sum.x + segment.x;
        sum.y += segment.y + uint(low < sum.x);
        sum.x = low;
    }
    words[counter] = sum;
}
