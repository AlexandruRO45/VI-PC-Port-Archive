#version 450

// Adds the segments of one split pipeline-statistics query (D3D-162): one invocation per counter of the result, in
// D3D12 field order. `counters` is the result's: 11 (D3D12_QUERY_DATA_PIPELINE_STATISTICS) or 14
// (D3D12_QUERY_DATA_PIPELINE_STATISTICS1, D3D-132); each segment record is `counters` words.
// Full segments hold the eleven Vulkan statistics at 0..10, which are the D3D12 order (VkQueryPipelineStatisticFlagBits
// order). `mesh` segments come from the pool a mesh draw can run in (D3D-291), which counts only clipping, fragment
// and compute invocations, and for a PIPELINE_STATISTICS1 query task and mesh invocations after them: they are copied
// to words 5..8 (or 5..10) of their record, and for PIPELINE_STATISTICS1 the segment's mesh-primitives query to word
// 13. So CSInvocations, ASInvocations and MSInvocations sit two words early, and the input-assembly, vertex, geometry
// and tessellation fields (0..4, 8 and 9) add nothing. A full segment adds nothing past field 10: it ran no mesh draw.
layout(local_size_x = 14) in;
layout(set = 0, binding = 0, std430) buffer QueryResults {
    uvec2 words[];  // `counters` running sums, then `count` records of `counters` words each
};
layout(push_constant) uniform ResolveRange {
    uint count;
    uint mesh;
    uint counters;
};

void main() {
    const uint counter = gl_LocalInvocationID.x;
    if (counter >= counters) return;
    bool counted = counter < 11u;
    uint source = counter;
    if (mesh != 0u) {
        counted = (counter >= 5u && counter <= 7u) || counter >= 10u;
        source = counter >= 10u && counter <= 12u ? counter - 2u : counter;
    }
    uvec2 sum = words[counter];
    for (uint i = 0; counted && i < count; ++i) {
        uvec2 segment = words[counters + i * counters + source];
        uint low = sum.x + segment.x;
        sum.y += segment.y + uint(low < sum.x);
        sum.x = low;
    }
    words[counter] = sum;
}
