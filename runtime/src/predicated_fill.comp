// Synthetic byte-granular repeating-element buffer fill, executed inside the captured conditional-rendering scope.
#version 450
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Destination { uint8_t bytes[]; } destination;
layout(push_constant) uniform Params {
    uint dst_offset;
    uint total_bytes;
    uint elem_size;
    uint phase;
    uint pat0;
    uint pat1;
    uint pat2;
    uint pat3;
} p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.total_bytes) return;
    uint b = (p.phase + i) % p.elem_size;
    uint w = b < 4u ? p.pat0 : (b < 8u ? p.pat1 : (b < 12u ? p.pat2 : p.pat3));
    destination.bytes[p.dst_offset + i] = uint8_t((w >> ((b & 3u) * 8u)) & 0xFFu);
}
