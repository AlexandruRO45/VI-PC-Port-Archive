// Synthetic strided byte-granular buffer copy, executed inside the captured conditional-rendering scope.
#version 450
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Source { uint8_t bytes[]; } source;
layout(set = 0, binding = 1, std430) buffer Destination { uint8_t bytes[]; } destination;
layout(push_constant) uniform Params {
    uint src_offset;
    uint dst_offset;
    uint row_bytes;
    uint rows;
    uint slices;
    uint src_row_pitch;
    uint src_slice_pitch;
    uint dst_row_pitch;
    uint dst_slice_pitch;
} p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint slice_bytes = p.row_bytes * p.rows;
    uint total = slice_bytes * p.slices;
    if (i >= total) return;
    uint z = i / slice_bytes;
    uint rem = i - z * slice_bytes;
    uint y = rem / p.row_bytes;
    uint x = rem - y * p.row_bytes;
    uint s = p.src_offset + z * p.src_slice_pitch + y * p.src_row_pitch + x;
    uint d = p.dst_offset + z * p.dst_slice_pitch + y * p.dst_row_pitch + x;
    destination.bytes[d] = source.bytes[s];
}
