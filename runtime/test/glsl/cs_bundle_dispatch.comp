#version 460
// A compute shader written to the translator's runtime contract (see cs_user_data.comp), for d3d12_bundle_test:
// the root arguments of the list that runs it, as the layer packs them, decide what it writes.
//   s0, s1   root constants: base and step
//   s2:s3    a root UAV: the console VA of the output buffer
// out[i] = s0 + s1 * i
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words {
    uint w[];
};

layout(push_constant) uniform UserData {
    uint s[32];
    uvec2 heap_base;
    uvec2 code_base;
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    uint carry;
    const uint low = uaddCarry(pc.heap_base.x, pc.s[2], carry);
    Words result = Words(uvec2(low, pc.heap_base.y + pc.s[3] + carry));
    result.w[i] = pc.s[0] + pc.s[1] * i;
}
