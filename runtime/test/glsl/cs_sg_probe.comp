#version 460
// A compute shader written to the translator's runtime contract that stores the subgroup size the driver ran it
// with (gl_SubgroupSize) in out[0], for d3d12_subgroup_test. s0:s1 is a root UAV: the console VA of the output.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words {
    uint w[];
};

#ifdef PC_TAIL
layout(push_constant) uniform UserData {
    uint s[32];
} pc;
layout(set = 1, binding = 0) uniform PcTail {
    uvec2 heap_base;
    uvec2 code_base;
} tail;
#define HEAP_BASE tail.heap_base
#else
layout(push_constant) uniform UserData {
    uint s[32];
    uvec2 heap_base;
    uvec2 code_base;
} pc;
#define HEAP_BASE pc.heap_base
#endif

uvec2 add64(uvec2 a, uvec2 b) {
    uint carry;
    const uint low = uaddCarry(a.x, b.x, carry);
    return uvec2(low, a.y + b.y + carry);
}

void main() {
    Words out_words = Words(add64(HEAP_BASE, uvec2(pc.s[0], pc.s[1])));
    if (gl_LocalInvocationIndex == 0u) out_words.w[0] = gl_SubgroupSize;
}
