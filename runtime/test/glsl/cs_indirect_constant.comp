#version 460
// A compute shader written to the translator's contract (docs/design.md, "User data"), standing in for a translated one
// in d3d12_indirect_signature_test: s0:s1 is a root UAV (a console VA), s2 a root constant. Each group adds 1 to word 0
// and raises word 1 to the constant + 1, so the words read back are the group count and the constant the groups saw.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
layout(local_size_x = 1) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint w[]; };
layout(push_constant) uniform UserData {
    uint s[32];
    uvec2 heap_base;
    uvec2 code_base;
} pc;

uvec2 add64(uvec2 a, uvec2 b) {
    uint carry;
    const uint low = uaddCarry(a.x, b.x, carry);
    return uvec2(low, a.y + b.y + carry);
}

void main() {
    Words result = Words(add64(pc.heap_base, uvec2(pc.s[0], pc.s[1])));
    atomicAdd(result.w[0], 1u);
    atomicMax(result.w[1], pc.s[2] + 1u);
}
