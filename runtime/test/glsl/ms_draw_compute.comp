#version 460
// test/glsl/ms_draw.mesh written to the `rdna2spirv.py --mesh-compute` contract instead (docs/design.md, "Mesh shaders
// as compute"), standing in for a translated mesh shader in d3d12_mesh_compute_test. Each workgroup writes one slot of
// the output buffer whose address is in push-constant dwords 36..37: slot = (x + y*nx + z*nx*ny) * 176 bytes. A slot
// is the layout rdna2spirv.mesh_compute_layout gives 4 vertices, 2 primitives and one param at location 0: a 16-byte
// header (vertex count, primitive count), 4 vertices of 32 bytes (position, then the colour), then 2 primitives of 16
// bytes (three vertex indices, then 1 if culled). The quad is ms_draw.mesh's: column = x + z, row = y on a 4x4 grid of
// clip-space cells, moved by s0, s1 (root constants), red, triangles (0,1,2) and (2,1,3).
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout(local_size_x = 32) in;

layout(buffer_reference, std430, buffer_reference_align = 16) buffer Slot {
    uint words[];
};

layout(push_constant) uniform UserData {
    uint s[32];
    uvec2 heap_base;
    uvec2 code_base;
    uvec2 output_address;
} pc;

const uint slot_bytes = 176u, vertices = 16u, vertex_stride = 32u, primitives = 144u;

uvec2 add64(uvec2 a, uint b) {
    uint carry;
    const uint low = uaddCarry(a.x, b, carry);
    return uvec2(low, a.y + carry);
}

void main() {
    const uvec3 n = gl_NumWorkGroups, g = gl_WorkGroupID;
    const uint group = g.x + g.y * n.x + g.z * n.x * n.y;
    Slot slot = Slot(add64(pc.output_address, group * slot_bytes));
    const uint i = gl_LocalInvocationIndex;
    if (i == 0) {
        slot.words[0] = 4u;  // vertices
        slot.words[1] = 2u;  // primitives
    }
    if (i < 4) {
        const float column = float(g.x + g.z), row = float(g.y);
        const vec2 offset = vec2(uintBitsToFloat(pc.s[0]), uintBitsToFloat(pc.s[1]));
        const vec2 corner = vec2(float(i & 1u), float(i >> 1));
        const vec2 top_left = vec2(-1.0 + 0.5 * column, 1.0 - 0.5 * row);
        const vec4 position = vec4(top_left + vec2(0.5, -0.5) * corner + offset, 0.0, 1.0);
        const vec4 colour = vec4(1.0, 0.0, 0.0, 1.0);
        const uint at = (vertices + i * vertex_stride) / 4u;
        for (uint c = 0; c < 4; ++c) {
            slot.words[at + c] = floatBitsToUint(position[c]);
            slot.words[at + 4u + c] = floatBitsToUint(colour[c]);
        }
    }
    if (i < 2) {
        const uvec3 corners = i == 0 ? uvec3(0, 1, 2) : uvec3(2, 1, 3);
        const uint at = (primitives + i * 16u) / 4u;
        slot.words[at] = corners.x;
        slot.words[at + 1u] = corners.y;
        slot.words[at + 2u] = corners.z;
        slot.words[at + 3u] = 0u;  // not culled
    }
}
