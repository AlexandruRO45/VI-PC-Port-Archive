# Fails when the PE at ${TOOL} reserves less than ${MIN_STACK} bytes of stack (SizeOfStackReserve).
# vk_pipeline_check needs it on Windows: the AMD driver's shader compiler overflows the 1 MB default (#4816).
foreach(var TOOL MIN_STACK)
  if("${${var}}" STREQUAL "")
    message(FATAL_ERROR "${var} is not set: pass -D${var}=... (the check would pass without it)")
  endif()
endforeach()
if(NOT MIN_STACK MATCHES "^[0-9]+$")
  message(FATAL_ERROR "MIN_STACK must be a number of bytes, got '${MIN_STACK}'")
endif()
if(NOT EXISTS "${TOOL}")
  message(FATAL_ERROR "${TOOL} does not exist")
endif()
file(READ "${TOOL}" hex HEX LIMIT 4096)
function(le_value offset size out)
  math(EXPR first "2 * ${offset}")
  math(EXPR chars "2 * ${size}")
  string(SUBSTRING "${hex}" ${first} ${chars} bytes)
  set(value 0)
  math(EXPR last "${size} - 1")
  foreach(i RANGE ${last})
    math(EXPR n "${last} - ${i}")
    math(EXPR at "2 * ${n}")
    string(SUBSTRING "${bytes}" ${at} 2 byte)
    math(EXPR value "(${value} << 8) | 0x${byte}")
  endforeach()
  set(${out} ${value} PARENT_SCOPE)
endfunction()
string(SUBSTRING "${hex}" 0 4 mz)
if(NOT mz STREQUAL "4d5a")
  message(FATAL_ERROR "${TOOL} is not a PE file")
endif()
le_value(60 4 pe)                       # e_lfanew
le_value(${pe} 4 sig)
if(NOT sig EQUAL 0x4550)
  message(FATAL_ERROR "no PE signature at ${pe}")
endif()
math(EXPR opt "${pe} + 24")            # optional header; SizeOfStackReserve is at +72 in PE32 and PE32+
le_value(${opt} 2 magic)
if(magic EQUAL 0x20b)
  set(width 8)
else()
  set(width 4)
endif()
math(EXPR at "${opt} + 72")
le_value(${at} ${width} reserve)
message(STATUS "SizeOfStackReserve = ${reserve}")
if(reserve LESS MIN_STACK)
  message(FATAL_ERROR "SizeOfStackReserve ${reserve} is below ${MIN_STACK}")
endif()
