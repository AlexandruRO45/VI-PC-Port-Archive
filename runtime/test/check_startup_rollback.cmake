foreach(mode IN ITEMS native_load native_executable mapped loader mapped_reentrant loader_reentrant loader_success loader_success_reentrant loader_destructor loader_destructor_reentrant)
  string(REPLACE "_reentrant" "" base_mode "${mode}")
  if(base_mode STREQUAL "native_load")
    set(command "${NATIVE}" "${DLL}")
    set(expected_code 0)
  elseif(base_mode STREQUAL "native_executable")
    set(command "${NATIVE}" --launch "${GUEST}")
    set(expected_code 0)
  elseif(base_mode STREQUAL "mapped")
    set(command "${RUNTIME}" --run "${GUEST}")
    set(expected_code 1)
  elseif(base_mode STREQUAL "loader_success" OR base_mode STREQUAL "loader_destructor")
    get_filename_component(directory "${DLL}" DIRECTORY)
    set(command "${HOST}" "${directory}/startup_rollback_a.dll")
    if(base_mode STREQUAL "loader_destructor")
      list(APPEND command --destruct)
    else()
      list(APPEND command --success)
    endif()
    set(expected_code 0)
  else()
    set(command "${HOST}" "${DLL}")
    set(expected_code 0)
  endif()
  if(mode MATCHES "_reentrant$")
    set(command "${CMAKE_COMMAND}" -E env LEONIDA_ROLLBACK_REENTER=1 ${RUNNER} ${command})
  else()
    set(command "${CMAKE_COMMAND}" -E env --unset=LEONIDA_ROLLBACK_REENTER ${RUNNER} ${command})
  endif()
  execute_process(COMMAND ${command}
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
  if(NOT code STREQUAL "${expected_code}" OR output MATCHES "EXECUTABLE_ENTRY_REACHED|EVENT [A-Z_]*INVALID")
    message(FATAL_ERROR "${mode} returned ${code}:\n${output}\n${errors}")
  endif()
  string(REGEX MATCHALL "EVENT [A-Z_]+" events "${output}")
  set(expected_events "EVENT A_TLS_ATTACH;EVENT A_ATTACH;EVENT B_REJECT;EVENT B_DETACH")
  if(base_mode STREQUAL "loader_success" OR base_mode STREQUAL "loader_destructor")
    set(expected_events "EVENT A_TLS_ATTACH;EVENT A_ATTACH")
  endif()
  if(NOT base_mode STREQUAL "native_executable")
    list(APPEND expected_events "EVENT A_TLS_DETACH")
    if(mode MATCHES "_reentrant$")
      list(APPEND expected_events "EVENT A_LOAD_BLOCKED" "EVENT A_LOOKUP_OK" "EVENT A_FORWARD_BLOCKED")
    endif()
    list(APPEND expected_events "EVENT A_DETACH")
  endif()
  if(NOT events STREQUAL expected_events)
    message(FATAL_ERROR "${mode}: unexpected event order/count:\n${output}\n${errors}")
  endif()
  string(REGEX MATCH "EVENT A_ATTACH count=1 tid=([0-9]+) value=0x6A" attach "${output}")
  if(NOT attach)
    message(FATAL_ERROR "${mode}: missing valid process attach:\n${output}")
  endif()
  set(attach_thread "${CMAKE_MATCH_1}")
  foreach(event IN LISTS expected_events)
    if(event MATCHES "^EVENT A_")
      string(REGEX MATCH "${event} count=1 tid=${attach_thread} value=0x6A(\r?\n|$)" valid "${output}")
      if(NOT valid)
        message(FATAL_ERROR "${mode}: incorrect callback count, thread or TLS for ${event}:\n${output}")
      endif()
    endif()
  endforeach()
  if(base_mode STREQUAL "mapped" AND NOT errors MATCHES "DllMain returned FALSE")
    message(FATAL_ERROR "Missing initialization failure diagnostic:\n${errors}")
  endif()
  message(STATUS "${mode} exit=${code}\n${output}")
endforeach()