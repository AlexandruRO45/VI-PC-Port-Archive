# Exercise the actual parser before scene I/O or Vulkan, including on hosts with no GPU.
file(MAKE_DIRECTORY "${TEST_DIR}")
file(WRITE "${TEST_DIR}/invalid-scene.bin" "not a scene\n")

function(check_invalid option)
  execute_process(COMMAND ${RUNNER} "${TOOL}" "${TEST_DIR}/invalid-scene.bin" unused-vs unused-ps
                  --out "${TEST_DIR}/frame.ppm" "${option}" ${ARGN}
                  RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 5)
  if(NOT code STREQUAL "2" OR NOT err MATCHES "${option} requires a valid value")
    message(FATAL_ERROR "${option} ${ARGN}: expected usage error before scene/Vulkan, got ${code}\n${out}${err}")
  endif()
endfunction()

check_invalid(--size)
check_invalid(--size 64)
foreach(value 0 -1 nope 64px 1.5 2147483648 4294967296 18446744073709551616)
  check_invalid(--size "${value}" 64)
  check_invalid(--size 64 "${value}")
endforeach()
check_invalid(--fov)
foreach(value 0 -1 180 181 nan inf -inf 1e100 1e-100 1e-37 70deg 1.2.3)
  check_invalid(--fov "${value}")
endforeach()
check_invalid(--cam 0 0 0 0)
foreach(value nan inf -inf 1e100 1e-100 nonsense 1.2.3)
  foreach(index RANGE 0 4)
    set(camera 0 0 0 0 0)
    list(REMOVE_AT camera ${index})
    list(INSERT camera ${index} "${value}")
    check_invalid(--cam ${camera})
  endforeach()
endforeach()
check_invalid(--frames)
foreach(value 0 -1 1.5 nope 3frames 2147483648)
  check_invalid(--frames "${value}")
endforeach()
check_invalid(--mode)
check_invalid(--mode flying)

function(check_valid)
  execute_process(COMMAND ${RUNNER} "${TOOL}" "${TEST_DIR}/invalid-scene.bin" unused-vs unused-ps
                  --out "${TEST_DIR}/frame.ppm" ${ARGN}
                  RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 5)
  if(NOT code STREQUAL "2" OR NOT err MATCHES "bad scene file")
    message(FATAL_ERROR "${ARGN}: valid arguments should reach scene loading, got ${code}\n${out}${err}")
  endif()
endfunction()

check_valid()
check_valid(--size 1920 1080 --fov 90 --cam -20.5 +2 1e2 -180 30 --mode fly)
check_valid(--size +64 64 --fov 0.001 --cam 0 0 0 0 0 --mode walk)
check_valid(--size 2147483647 1 --fov 179.9 --frames 2147483647 --mode drive)
if(EXISTS "${TEST_DIR}/frame.ppm")
  message(FATAL_ERROR "Parser checks unexpectedly wrote a frame")
endif()
