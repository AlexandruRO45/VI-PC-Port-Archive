# The same original fixture uses native paths or GAME: paths. It performs real imported Win32 calls.
# Every package, host control and writable overlay is synthetic and local to this test's build directory.
set(work "${CMAKE_CURRENT_BINARY_DIR}/current-directory-fixture")
file(REMOVE_RECURSE "${work}")
foreach(mode native mapped)
  set(base "${work}/${mode}")
  file(MAKE_DIRECTORY "${base}/package/data/sub/child" "${base}/package/empty" "${base}/host")
  foreach(index RANGE 0 2)
    file(MAKE_DIRECTORY "${base}/package/review-alias-${index}-a" "${base}/package/review-alias-${index}-w")
  endforeach()
  file(WRITE "${base}/package/data/data.txt" "package")
  file(WRITE "${base}/package/data/deleted.txt" "deleted")
  file(WRITE "${base}/package/data/plain" "plain")
  file(WRITE "${base}/host/host.txt" "host")
  file(GLOB_RECURSE package_before LIST_DIRECTORIES true RELATIVE "${base}/package" "${base}/package/*")
  if(mode STREQUAL "native")
    file(MAKE_DIRECTORY "${base}/scratch")
    set(command ${RUNNER} "${GUEST}" "${base}/package" "${base}/host" "${base}/scratch")
  else()
    set(command ${RUNNER} "${LOADER}" --game-dir "${base}/package" --overlay "${base}/overlay"
                --run "${GUEST}" -- "GAME:" "${base}/host" "T:\\")
  endif()
  execute_process(COMMAND ${command} WORKING_DIRECTORY "${base}/host" TIMEOUT 90
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE output)
  string(REPLACE "\r\n" "\n" output "${output}")
  if(NOT code STREQUAL "0" OR NOT output MATCHES "(^|\n)tiny_current_directory: OK(\n|$)"
      OR output MATCHES "tiny_current_directory: FAIL"
      OR (mode STREQUAL "mapped" AND NOT output MATCHES "game exited with code 0"))
    message(FATAL_ERROR "${mode} current-directory fixture failed (${code}):\n${output}")
  endif()
  file(READ "${base}/host/host.txt" host)
  if(NOT host STREQUAL "host+host")
    message(FATAL_ERROR "${mode} absolute host write did not reach the host control")
  endif()
  if(mode STREQUAL "mapped")
    file(GLOB_RECURSE package_after LIST_DIRECTORIES true RELATIVE "${base}/package" "${base}/package/*")
    file(READ "${base}/package/data/data.txt" original)
    file(READ "${base}/package/data/deleted.txt" deleted)
    file(READ "${base}/package/data/plain" plain)
    file(READ "${base}/overlay/data/data.txt" overlay)
    file(READ "${base}/overlay/data/new.txt" created)
    if(NOT package_before STREQUAL package_after OR NOT original STREQUAL "package" OR NOT deleted STREQUAL "deleted"
        OR NOT plain STREQUAL "plain"
        OR EXISTS "${base}/package/data/new.txt" OR NOT overlay STREQUAL "package+overlay" OR NOT created STREQUAL "new")
      message(FATAL_ERROR "Mapped relative operations did not preserve the package and write the overlay")
    endif()
    file(GLOB overlay_names RELATIVE "${base}/overlay/data" "${base}/overlay/data/*")
    foreach(device CON CONOUT$ CONIN$)
      if(device IN_LIST overlay_names)
        message(FATAL_ERROR "Mapped device open created a regular overlay file: ${device}")
      endif()
    endforeach()
  endif()
  string(REGEX MATCH "tiny_current_directory: [0-9]+ checks, [0-9]+ failures" verdict "${output}")
  message(STATUS "${mode}: ${verdict}")
endforeach()
file(REMOVE_RECURSE "${work}")
