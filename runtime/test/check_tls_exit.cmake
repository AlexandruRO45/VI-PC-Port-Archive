# Exact native Windows TLS-destruction order, then the same source through gta6rt. Under Wine report host-CRT
# differences separately, as check_atexit.cmake does; the mapped path still has to match the Windows sequence.
get_filename_component(guest_dir "${GUEST}" DIRECTORY)
get_filename_component(guest_name "${GUEST}" NAME)
set(code 20)
set(failures "")
foreach(mode return exit cexit worker_exit cexit_exit c_exit_exit)
  math(EXPR code "${code} + 1")
  set(expected "touch main")
  if(mode STREQUAL "return" OR mode STREQUAL "exit" OR mode STREQUAL "cexit" OR mode STREQUAL "cexit_exit")
    list(APPEND expected "tls dtor main same-thread" "atexit" "static dtor")
    if(mode STREQUAL "cexit" OR mode STREQUAL "cexit_exit")
      list(APPEND expected "after cexit")
    endif()
    if(mode STREQUAL "cexit_exit")
      list(APPEND expected "touch later" "tls dtor later same-thread")
    endif()
  elseif(mode STREQUAL "worker_exit")
    list(APPEND expected "touch worker" "tls dtor worker same-thread" "atexit" "static dtor")
  elseif(mode STREQUAL "c_exit_exit")
    list(APPEND expected "after c_exit" "tls dtor main same-thread" "atexit" "static dtor")
  endif()
  foreach(leg native mapped)
    if(leg STREQUAL "native")
      set(command "${GUEST}" "${mode}")
    else()
      set(command "${LOADER}" --run "${guest_name}" -- "${mode}")
    endif()
    execute_process(COMMAND ${RUNNER} ${command} WORKING_DIRECTORY "${guest_dir}" TIMEOUT 30
      RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    string(REPLACE "\r\n" "\n" stdout "${stdout}")
    string(REPLACE ";" "," stdout "${stdout}")
    string(REPLACE "\n" ";" stdout "${stdout}")
    set(actual)
    foreach(line IN LISTS stdout)
      if(line MATCHES "^tiny_tls_exit: (.*)$")
        list(APPEND actual "${CMAKE_MATCH_1}")
      endif()
    endforeach()
    if(NOT result STREQUAL "${code}" OR NOT actual STREQUAL expected)
      string(CONCAT difference "[${mode}/${leg}] expected (${code}): ${expected}\n"
        "  got (${result}): ${actual}\n${stderr}")
      if(RUNNER AND leg STREQUAL "native")
        message(STATUS "${difference}\n(the host CRT differs from Windows; not a gta6rt failure)")
      else()
        string(APPEND failures "\n${difference}")
      endif()
    endif()
  endforeach()
endforeach()
if(failures)
  message(FATAL_ERROR "TLS/termination differences:${failures}")
endif()
message(STATUS "tiny_tls_exit: 6 full-cleanup paths match native Windows TLS destruction")
