<Project Sdk="Microsoft.NET.Sdk">

  <!-- The launcher's engine: options, the build process, its monitoring, settings, history and hardware detection.
       No UI and no NuGet packages, so it can be tested from a plain console program (tests/Leonida.Core.Tests). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Leonida.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
