<UserControl x:Class="Leonida.Launcher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <!-- ===== The landing page ===== -->
    <ScrollViewer x:Name="Landing" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
      <StackPanel Margin="56,4,56,48" MaxWidth="1180">
        <Grid Margin="0,10,0,34">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0">
            <StackPanel Orientation="Horizontal">
              <Image Source="/Assets/logo.png" Width="120" Height="120" RenderOptions.BitmapScalingMode="HighQuality" Margin="-8,0,10,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="LEONIDA" Style="{StaticResource H1}" FontSize="78" Margin="0,0,0,-10"/>
                <Rectangle Height="5" Fill="{StaticResource Sunset}" Width="210" HorizontalAlignment="Left"/>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="Tagline" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,10" Foreground="{DynamicResource Heading}"/>
            <FlowDocumentScrollViewer x:Name="Intro" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                      IsToolBarVisible="False" Focusable="False" Margin="-2,0,0,0"/>
          </StackPanel>

          <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0">
            <DockPanel>
              <Border DockPanel.Dock="Bottom" Style="{StaticResource Caption}">
                <TextBlock Text="Project information" Style="{StaticResource CaptionText}"/>
              </Border>
              <StackPanel Margin="18,16,18,14">
                <TextBlock Text="SUPPORTED GAME" Style="{StaticResource Label}"/>
                <TextBlock x:Name="GameVersion" Text="…" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap"/>
                <TextBlock Text="YOUR CHECKOUT" Style="{StaticResource Label}"/>
                <TextBlock x:Name="Checkout" Text="…" FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap"/>
                <TextBlock Text="CONTRIBUTORS" Style="{StaticResource Label}"/>
                <TextBlock x:Name="ContributorCount" Text="…" FontSize="13" Margin="0,0,0,12"/>
                <TextBlock Text="LINKS" Style="{StaticResource Label}"/>
                <WrapPanel x:Name="Links" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>

        <!-- One tile per section page -->
        <ItemsControl x:Name="SectionTiles" Margin="0,0,-18,0">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Margin="0,0,18,18" Cursor="Hand" Tag="{Binding Key}" MouseLeftButtonUp="OnTile">
                <DockPanel>
                  <Border DockPanel.Dock="Bottom" Style="{StaticResource Caption}"><TextBlock Text="{Binding Title}" Style="{StaticResource CaptionText}"/></Border>
                  <Grid Height="104" Background="{DynamicResource CardAlt}">
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="44" Foreground="{Binding Brush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="ReadmeError" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,16"/>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== One README section ===== -->
    <ScrollViewer x:Name="SectionPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
      <StackPanel Margin="56,0,56,48" MaxWidth="1180">
        <TextBlock x:Name="SectionTitle" Style="{StaticResource H1}" FontSize="56"/>
        <Rectangle Height="5" Fill="{StaticResource Sunset}" Width="160" HorizontalAlignment="Left" Margin="2,0,0,22"/>
        <Border Style="{StaticResource Card}">
          <FlowDocumentScrollViewer x:Name="SectionBody" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                    IsToolBarVisible="False" Margin="26,20,26,12"/>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== Credits: everyone who wrote Leonida ===== -->
    <Grid x:Name="CreditsPage" Visibility="Collapsed" Margin="56,0,56,24" MaxWidth="1180">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
        <TextBlock Text="CREDITS" Style="{StaticResource H1}" FontSize="56"/>
        <Rectangle Height="5" Fill="{StaticResource Sunset}" Width="160" HorizontalAlignment="Left" Margin="2,0,0,18"/>
      </StackPanel>
      <Grid Grid.Row="1" Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource Ink}" Padding="18,8" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock x:Name="PeopleCount" Foreground="#FFFFFF" FontFamily="{StaticResource DisplayBold}" FontSize="30"/>
              <TextBlock Text="PEOPLE" Foreground="#AAAAAA" FontSize="10.5" FontWeight="Bold"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Ink}" Padding="18,8">
            <StackPanel>
              <TextBlock x:Name="CommitCount" Foreground="#FFFFFF" FontFamily="{StaticResource DisplayBold}" FontSize="30"/>
              <TextBlock Text="COMMITS" Foreground="#AAAAAA" FontSize="10.5" FontWeight="Bold"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="PeopleNote" Style="{StaticResource Hint}" Margin="20,0,20,0" VerticalAlignment="Center"/>
        <Grid Grid.Column="2" Width="260" VerticalAlignment="Center">
          <TextBox x:Name="PeopleSearch" Padding="30,6,8,6" TextChanged="OnPeopleSearch" ToolTip="Find someone"/>
          <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource Faint}" Margin="10,0,0,0"
                     VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Effect="{StaticResource SoftShadow}">
        <ListBox x:Name="People" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Foreground" Value="{DynamicResource Heading}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,9">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource CardAlt}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="54"/>
                  <ColumnDefinition Width="58"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="240"/>
                  <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Rank}" FontFamily="{StaticResource DisplayBold}" FontSize="18" Foreground="{Binding RankBrush}" VerticalAlignment="Center"/>
                <!-- The profile picture, or the initial in a coloured circle while it loads / without one -->
                <Grid Grid.Column="1" Width="42" Height="42" HorizontalAlignment="Left">
                  <Ellipse Fill="{Binding Color}"/>
                  <TextBlock Text="{Binding Initial}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Ellipse>
                    <Ellipse.Fill><ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill"/></Ellipse.Fill>
                  </Ellipse>
                  <Ellipse Stroke="#1A000000" StrokeThickness="1"/>
                </Grid>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Handle}" FontSize="11.5" Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Grid Grid.Column="3" Height="6" VerticalAlignment="Center" Margin="0,0,18,0" Background="{DynamicResource CardAlt}">
                  <Rectangle HorizontalAlignment="Left" Width="{Binding BarWidth}" Fill="{StaticResource Sunset}"/>
                </Grid>
                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Commits}" FontFamily="{StaticResource DisplayBold}" FontSize="20" HorizontalAlignment="Right"/>
                  <TextBlock Text="COMMITS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Faint}" HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>
  </Grid>
</UserControl>
