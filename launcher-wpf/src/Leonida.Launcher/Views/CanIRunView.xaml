<UserControl x:Class="Leonida.Launcher.Views.CanIRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Spec" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#1A1A1A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="0,0,14,0"/>
      <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
    </Style>
  </UserControl.Resources>
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="56,0,56,40" MaxWidth="1260">
        <TextBlock Text="CAN I RUN LEONIDA?" Style="{StaticResource H1}" FontSize="58"/>
        <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
          <Ellipse x:Name="HeadDot" Width="14" Height="14" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,2,12,0"/>
          <TextBlock x:Name="Headline" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Text="Checking your PC…"/>
        </StackPanel>
        <TextBlock x:Name="Subline" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="28,0,0,22"/>

        <!-- Your PC -->
        <DockPanel Margin="0,0,0,8">
          <Button x:Name="DetectButton" DockPanel.Dock="Right" Style="{StaticResource Outline}" Content="Detect again" Tag="&#xE72C;"
                  Click="OnDetect" VerticalAlignment="Bottom" Padding="12,4" Margin="0"
                  ToolTip="Read the processor, graphics and memory from Windows again and compare once more"/>
          <TextBlock Text="YOUR PC" Style="{StaticResource Label}" FontSize="12"/>
        </DockPanel>
        <UniformGrid Columns="3" Margin="0,0,-14,26">
          <Border Style="{StaticResource Spec}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="&#xE950;" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="{StaticResource Purple}" Margin="0,2,14,0"/>
              <StackPanel>
                <TextBlock Text="PROCESSOR" Style="{StaticResource Label}"/>
                <TextBlock x:Name="CpuText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CpuDetail" FontSize="11.5" Foreground="#777777" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Spec}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="{StaticResource Pink}" Margin="0,2,14,0"/>
              <StackPanel>
                <TextBlock Text="GRAPHICS" Style="{StaticResource Label}"/>
                <TextBlock x:Name="GpuText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="GpuDetail" FontSize="11.5" Foreground="#777777" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Spec}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="&#xEEA1;" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="{StaticResource Orange}" Margin="0,2,14,0"/>
              <StackPanel>
                <TextBlock Text="MEMORY" Style="{StaticResource Label}"/>
                <TextBlock x:Name="RamText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="RamDetail" FontSize="11.5" Foreground="#777777" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </UniformGrid>

        <!-- Every console on the checker's list -->
        <TextBlock Text="COMPARED WITH EVERY CONSOLE ON THE LIST" Style="{StaticResource Label}" FontSize="12" Margin="0,0,0,8"/>
        <TextBlock x:Name="CompareStatus" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <ItemsControl x:Name="Tiles" Margin="0,0,-16,0">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                <DockPanel>
                  <Border DockPanel.Dock="Bottom" Background="{Binding VerdictBrush}" Padding="12,9">
                    <TextBlock Text="{Binding Verdict}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                  </Border>
                  <StackPanel>
                    <Border Background="#0A0A0A" Padding="14,10" MinHeight="74">
                      <TextBlock Text="{Binding Label}" Foreground="#FFFFFF" FontFamily="{StaticResource DisplayBold}" FontSize="20"
                                 TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="21" LineStackingStrategy="BlockLineHeight"/>
                    </Border>
                    <Rectangle Height="3" Fill="{StaticResource Sunset}"/>
                    <ItemsControl ItemsSource="{Binding Parts}" Margin="14,12,14,8">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,0,9" ToolTip="{Binding Reference}">
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{Binding Brush}" FontWeight="Bold" FontSize="12"/>
                              <TextBlock Text="{Binding Part}" FontWeight="Bold" FontSize="11" Foreground="#555555"/>
                            </DockPanel>
                            <Rectangle Height="4" Fill="{Binding Brush}" Margin="0,3,0,2"/>
                            <TextBlock Text="{Binding Reference}" FontSize="10.5" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="Attribution" FontSize="11.5" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,6,0,6"/>
      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
