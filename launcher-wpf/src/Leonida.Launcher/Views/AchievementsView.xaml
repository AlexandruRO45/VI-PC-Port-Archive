<UserControl x:Class="Leonida.Launcher.Views.AchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="56,40,56,30">
    <StackPanel MaxWidth="1180">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,6">
          <TextBlock x:Name="Count" FontFamily="{StaticResource DisplayBold}" FontSize="30" Foreground="{DynamicResource Heading}" HorizontalAlignment="Right"/>
          <TextBlock x:Name="Score" FontSize="12" Foreground="{DynamicResource SubText}" HorizontalAlignment="Right"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="ACHIEVEMENTS" Style="{StaticResource H1}"/>
          <Rectangle Height="4" Width="96" Fill="{StaticResource Sunset}" HorizontalAlignment="Left" Margin="0,2,0,0"/>
        </StackPanel>
      </DockPanel>

      <!-- What this page is: a test, nothing unlocks yet -->
      <Border Background="{DynamicResource CaptionBg}" Margin="0,20,0,10" Padding="18,14">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{StaticResource Pink}" Margin="0,2,16,0" VerticalAlignment="Top"/>
          <StackPanel>
            <TextBlock Text="A test page: nothing unlocks yet" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14.5"/>
            <TextBlock Foreground="#D0D0D0" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Achievements will only work if someone finds a way for Leonida to take over the achievement unlocks the game itself makes. Until then every achievement stays locked, and nothing is sent anywhere."/>
          </StackPanel>
        </DockPanel>
      </Border>
      <DockPanel Margin="0,0,0,14">
        <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="The list on GitHub" Click="OnOpenList" VerticalAlignment="Center"/>
        <TextBlock x:Name="Source" FontSize="11.5" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>

      <!-- No list yet -->
      <Border x:Name="Empty" Style="{StaticResource Card}" Padding="24,22" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="No achievement list yet" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Heading}"/>
          <TextBlock x:Name="EmptyText" FontSize="12.5" Foreground="{DynamicResource SubText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <Button x:Name="DownloadButton" Style="{StaticResource Outline}" Content="Download the list" Click="OnDownload" Padding="14,7" Margin="0,14,0,0" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <ItemsControl x:Name="List">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,12,12" Padding="12"
                    Cursor="{Binding Cursor}" MouseLeftButtonUp="OnCard">
              <DockPanel>
                <!-- The launcher's own tile art: the sunset, the achievement's initial, dimmed with a lock while locked -->
                <Grid DockPanel.Dock="Left" Width="64" Height="64" Margin="0,0,14,0" VerticalAlignment="Top">
                  <Border CornerRadius="3" Background="{Binding Art}" Opacity="0.45"/>
                  <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource DisplayBold}" FontSize="30" Foreground="#E6FFFFFF"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4"/>
                  <Border Width="22" Height="22" CornerRadius="11" Background="#CC000000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
                <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Gamerscore}" FontFamily="{StaticResource DisplayBold}" FontSize="18" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                  <TextBlock Text="G" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Faint}" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Heading}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource SubText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding State}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Faint}" Margin="0,6,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
