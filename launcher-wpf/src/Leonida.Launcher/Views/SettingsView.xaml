<UserControl x:Class="Leonida.Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Outline}">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
    <Style x:Key="Body" TargetType="StackPanel">
      <Setter Property="Margin" Value="18,14,18,16"/>
    </Style>
  </UserControl.Resources>

  <Grid Background="{StaticResource Paper}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="270"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <!-- ===== Left: the sections, and Back ===== -->
    <Border Background="{StaticResource Ink}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,30,0,18">
          <TextBlock Text="SETTINGS" Foreground="#FFFFFF" FontFamily="{StaticResource DisplayBold}" FontSize="34" Margin="22,0,0,0"/>
          <Rectangle Height="4" Width="110" Fill="{StaticResource Sunset}" HorizontalAlignment="Left" Margin="22,2,0,0"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#262626" BorderThickness="0,1,0,0" Padding="0,10,0,14">
          <Button x:Name="BackButton" Style="{StaticResource SideAction}" Tag="&#xE72B;" Content="Back" Click="OnBack" FontSize="14"
                  AutomationProperties.Name="Back"/>
        </Border>
        <StackPanel>
          <RadioButton x:Name="NavLauncher" Style="{StaticResource SideNav}" Tag="&#xE713;" Content="Launcher settings" GroupName="settings"
                       Checked="OnSection" AutomationProperties.Name="Launcher settings"/>
          <RadioButton x:Name="NavLeonida" Style="{StaticResource SideNav}" Tag="&#xE7FC;" Content="Leonida settings" GroupName="settings"
                       Checked="OnSection" AutomationProperties.Name="Leonida settings"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Launcher settings ===== -->
    <ScrollViewer Grid.Column="1" x:Name="LauncherSection" VerticalScrollBarVisibility="Auto" Padding="48,70,48,24">
      <StackPanel MaxWidth="1100">
        <TextBlock Text="Launcher settings" Style="{StaticResource H1}" FontSize="44" Margin="0,0,0,18"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Caption}"><TextBlock Text="Appearance" Style="{StaticResource CaptionText}"/></Border>
                <StackPanel Style="{StaticResource Body}">
                  <TextBlock Text="LANGUAGE" Style="{StaticResource Label}"/>
                  <ComboBox x:Name="LanguageBox" Width="220" HorizontalAlignment="Left" SelectionChanged="OnLanguage" AutomationProperties.Name="Language"/>
                  <TextBlock Style="{StaticResource Hint}" Text="The launcher's language. README pages and the build's output stay in English."/>
                  <TextBlock Text="START PAGE" Style="{StaticResource Label}" Margin="0,14,0,4"/>
                  <ComboBox x:Name="StartPageBox" Width="220" HorizontalAlignment="Left" SelectionChanged="OnChanged"/>
                  <CheckBox x:Name="StartCollapsed" Content="Start with the sidebar collapsed" Margin="0,12,0,0" Checked="OnChanged" Unchecked="OnChanged"/>
                  <TextBlock Text="Your avatar" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                  <StackPanel Orientation="Horizontal">
                    <ContentControl x:Name="AvatarPreview" Width="56" Height="56"/>
                    <Button Style="{StaticResource Outline}" Content="New random avatar" Click="OnNewAvatar" Margin="14,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Caption}"><TextBlock Text="Online" Style="{StaticResource CaptionText}"/></Border>
                <StackPanel Style="{StaticResource Body}">
                  <CheckBox x:Name="AllowOnline" Checked="OnChanged" Unchecked="OnChanged">
                    <TextBlock TextWrapping="Wrap" Text="Allow online features (GitHub profile pictures in Credits, the Can I Run checker)"/>
                  </CheckBox>
                  <TextBlock Style="{StaticResource Hint}" Text="Off: nothing is fetched; Credits uses your git history and Can I Run shows only your hardware."/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Caption}"><TextBlock Text="Builds" Style="{StaticResource CaptionText}"/></Border>
                <StackPanel Style="{StaticResource Body}">
                  <CheckBox x:Name="StopGracefully" Content="Stop builds with Ctrl+C first (they resume next time)" Checked="OnChanged" Unchecked="OnChanged"/>
                  <StackPanel Orientation="Horizontal" Margin="22,6,0,0">
                    <TextBlock Text="then end them after" VerticalAlignment="Center"/>
                    <TextBox x:Name="GraceBox" Width="52" Margin="8,0" TextChanged="OnChanged"/>
                    <TextBlock Text="seconds" VerticalAlignment="Center"/>
                  </StackPanel>
                  <CheckBox x:Name="NotifyDone" Content="Flash the taskbar when a build ends" Margin="0,12,0,0" Checked="OnChanged" Unchecked="OnChanged"/>
                  <CheckBox x:Name="SoundDone" Content="Play a sound when a build ends" Checked="OnChanged" Unchecked="OnChanged"/>
                  <TextBlock Text="CONSOLE TEXT SIZE" Style="{StaticResource Label}" Margin="0,14,0,4"/>
                  <DockPanel>
                    <TextBlock x:Name="FontValue" DockPanel.Dock="Right" Width="40" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Slider x:Name="FontSlider" Minimum="10" Maximum="18" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnFont" VerticalAlignment="Center"/>
                  </DockPanel>
                  <Border Background="{StaticResource ConsoleBg}" Padding="10,6" Margin="0,6,0,0">
                    <TextBlock x:Name="FontPreview" Text="11:13:27  check: Xbox Series package 1.0.2.1, 108 files" Foreground="#D6D6D6" FontFamily="{StaticResource Mono}"/>
                  </Border>
                  <TextBlock Text="DELETE BUILD LOGS OLDER THAN" Style="{StaticResource Label}" Margin="0,14,0,4"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="KeepLogsBox" Width="52" TextChanged="OnChanged"/>
                    <TextBlock Text="days (0 keeps them all)" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  </StackPanel>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Caption}"><TextBlock Text="Files" Style="{StaticResource CaptionText}"/></Border>
                <StackPanel Style="{StaticResource Body}">
                  <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"><Run Text="Settings file:"/> <Run x:Name="SettingsPath"/></TextBlock>
                  <WrapPanel>
                    <Button Style="{StaticResource Danger}" Content="Restore defaults" Click="OnReset"/>
                    <Button Style="{StaticResource Outline}" Content="Open logs folder" Click="OnLogs"/>
                  </WrapPanel>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== Leonida settings ===== -->
    <ScrollViewer Grid.Column="1" x:Name="LeonidaSection" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="48,70,48,24">
      <StackPanel MaxWidth="1100">
        <TextBlock Text="Leonida settings" Style="{StaticResource H1}" FontSize="44" Margin="0,0,0,18"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Caption}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Check again" Click="OnRefresh" Foreground="#FFFFFF" Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                    <TextBlock Text="Your setup" Style="{StaticResource CaptionText}"/>
                  </DockPanel>
                </Border>
                <StackPanel Style="{StaticResource Body}">
                  <TextBlock x:Name="Summary" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                  <TextBlock x:Name="ChecksNote" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                  <ItemsControl x:Name="ToolList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="0,8">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" FontSize="16" Margin="0,1,12,0" VerticalAlignment="Top"
                                       Text="{Binding Glyph}" Foreground="{Binding Color}"/>
                            <StackPanel>
                              <TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding For, Mode=OneWay}" Foreground="#777777" FontSize="11.5"/></TextBlock>
                              <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="#555555" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding Hint}" FontSize="11.5" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Visibility="{Binding HintVisibility}"/>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="DiskText" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Caption}"><TextBlock Text="Play" Style="{StaticResource CaptionText}"/></Border>
                <StackPanel Style="{StaticResource Body}">
                  <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                             Text="PLAY runs gta6rt.exe --run on game_scarlett_master.exe from your copy (runtime/README.md)."/>
                  <TextBlock Text="OVERLAY FOLDER  (--overlay)" Style="{StaticResource Label}"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="OverlayBox" TextChanged="OnPlayChanged" ToolTip="Where whatever the title writes goes, so the package is never modified. Empty: &lt;game&gt;\overlay. Needed when the package is on a read-only drive."/>
                    <Button Grid.Column="1" Style="{StaticResource Small}" Content="Browse" Click="OnBrowseOverlay"/></Grid>
                  <TextBlock Text="MODS FOLDER  (--mods)" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ModsBox" TextChanged="OnPlayChanged" ToolTip="Mods to load (docs/modding.md). Empty: the mods folder next to gta6rt.exe."/>
                    <Button Grid.Column="1" Style="{StaticResource Small}" Content="Browse" Click="OnBrowseMods"/></Grid>
                  <CheckBox x:Name="VulkanBackend" Content="Vulkan D3D12 backend  (LEONIDA_D3D12=vulkan)" Margin="0,12,0,2" Checked="OnPlayChanged" Unchecked="OnPlayChanged"/>
                  <CheckBox x:Name="TraceD3D12" Content="Trace D3D12 calls  (--trace-d3d12)" Checked="OnPlayChanged" Unchecked="OnPlayChanged"/>
                  <TextBlock Text="STARTUP TRACE FILE  (--trace, a new file)" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                  <TextBox x:Name="TraceFileBox" TextChanged="OnPlayChanged"/>
                  <TextBlock Text="GAME ARGUMENTS  (after --)" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                  <TextBox x:Name="GameArgsBox" TextChanged="OnPlayChanged" FontFamily="{StaticResource Mono}"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Caption}"><TextBlock Text="Leonida folder, Python and environment" Style="{StaticResource CaptionText}"/></Border>
                <StackPanel Style="{StaticResource Body}">
                  <TextBlock Text="LEONIDA FOLDER (WITH BUILD.BAT)" Style="{StaticResource Label}"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="RepoBox" IsReadOnly="True" Background="#F6F6F6"/>
                    <Button Grid.Column="1" Style="{StaticResource Small}" Content="Change" Click="OnChooseRepo"/></Grid>
                  <TextBlock Style="{StaticResource Hint}" Text="Found by itself when Leonida.exe is next to Build.bat."/>
                  <TextBlock Text="PYTHON" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                  <TextBlock x:Name="PythonText" TextWrapping="Wrap" FontSize="12.5"/>
                  <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="PythonBox" ToolTip="Empty: found as Build.bat finds it (py -3.14 … py -3, then python)."/>
                    <Button Grid.Column="1" Style="{StaticResource Small}" Content="Browse" Click="OnBrowsePython"/></Grid>
                  <TextBlock Text="ENVIRONMENT VARIABLES FOR BUILDS AND PLAY" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                  <TextBox x:Name="EnvBox" AcceptsReturn="True" Height="86" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource Mono}" FontSize="12"
                           ToolTip="One NAME=value per line, e.g. LLVM_MC=C:\path\to\llvm-mc.exe. A variable left out keeps the value Windows gives it."/>
                  <WrapPanel Margin="0,10,0,0"><Button Style="{StaticResource Dark}" Content="Apply and check again" Click="OnApply"/></WrapPanel>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
