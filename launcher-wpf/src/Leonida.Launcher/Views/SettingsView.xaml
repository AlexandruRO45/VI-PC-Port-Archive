<UserControl x:Class="Leonida.Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Outline}">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- One setting: name and description on the left, its control on the right, a line under it -->
    <Style x:Key="Row" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="0,20"/>
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Heading}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="RowText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <Style x:Key="RowLeft" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,40,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Pick" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Width" Value="300"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="12,5,30,5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="36"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>
    <!-- The pages in the left column: a group heading, then its pages -->
    <Style x:Key="Group" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="24,26,0,8"/>
    </Style>
    <Style x:Key="PageNav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource SideMuted}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="settings"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" Height="36">
              <Grid>
                <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left" Fill="{StaticResource Sunset}" Visibility="Hidden"/>
                <ContentPresenter Margin="24,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource SideHover}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource Paper}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="270"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <!-- ===== Left: the launcher and its version, the pages, Back ===== -->
    <Border Background="{DynamicResource Ink}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,34,0,10">
          <Border Width="44" Height="44" CornerRadius="4" ClipToBounds="True">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#2A1452" Offset="0"/><GradientStop Color="#B42A78" Offset="0.62"/><GradientStop Color="#FF8A3D" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Image Source="../Assets/logo.png" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Leonida Launcher" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock x:Name="SideVersion" Foreground="{DynamicResource SideMuted}" FontSize="11.5"/>
          </StackPanel>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#262626" BorderThickness="0,1,0,0" Padding="0,10,0,14">
          <Button x:Name="BackButton" Style="{StaticResource SideAction}" Tag="&#xE72B;" Content="Back" Click="OnBack" FontSize="14"
                  AutomationProperties.Name="Back"/>
        </Border>
        <StackPanel>
          <TextBlock Text="Launcher settings" Style="{StaticResource Group}"/>
          <RadioButton x:Name="NavGeneral" Style="{StaticResource PageNav}" Tag="general" Content="General" Checked="OnSection" AutomationProperties.Name="General"/>
          <RadioButton x:Name="NavBuilds" Style="{StaticResource PageNav}" Tag="builds" Content="Builds" Checked="OnSection" AutomationProperties.Name="Builds"/>
          <RadioButton x:Name="NavOnline" Style="{StaticResource PageNav}" Tag="online" Content="Online" Checked="OnSection" AutomationProperties.Name="Online"/>
          <RadioButton x:Name="NavAbout" Style="{StaticResource PageNav}" Tag="about" Content="About and files" Checked="OnSection" AutomationProperties.Name="About and files"/>
          <TextBlock Text="Leonida settings" Style="{StaticResource Group}"/>
          <RadioButton x:Name="NavSetup" Style="{StaticResource PageNav}" Tag="setup" Content="Your setup" Checked="OnSection" AutomationProperties.Name="Your setup"/>
          <RadioButton x:Name="NavPlay" Style="{StaticResource PageNav}" Tag="play" Content="Play" Checked="OnSection" AutomationProperties.Name="Play options"/>
          <RadioButton x:Name="NavFolders" Style="{StaticResource PageNav}" Tag="folders" Content="Folders and Python" Checked="OnSection" AutomationProperties.Name="Folders and Python"/>
          <RadioButton x:Name="NavDisk" Style="{StaticResource PageNav}" Tag="disk" Content="Disk space" Checked="OnSection" AutomationProperties.Name="Disk space"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Right: the page shown ===== -->
    <ScrollViewer Grid.Column="1" x:Name="Pages" VerticalScrollBarVisibility="Auto" Padding="64,66,64,30">
      <StackPanel Width="860" HorizontalAlignment="Left">
        <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" FontSize="40"/>
        <Rectangle Height="4" Width="96" Fill="{StaticResource Sunset}" HorizontalAlignment="Left" Margin="0,2,0,10"/>

        <!-- ===== General ===== -->
        <StackPanel x:Name="PageGeneral">
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Language" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="The launcher's language. README pages and the build's output stay in English." Style="{StaticResource RowText}"/>
              </StackPanel>
              <ComboBox Grid.Column="1" x:Name="LanguageBox" Style="{StaticResource Pick}" SelectionChanged="OnLanguage" AutomationProperties.Name="Language"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Theme" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="Light, dark, or the same as Windows' app mode." Style="{StaticResource RowText}"/>
              </StackPanel>
              <ComboBox Grid.Column="1" x:Name="ThemeBox" Style="{StaticResource Pick}" SelectionChanged="OnTheme" AutomationProperties.Name="Theme"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Start page" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="What the launcher opens on." Style="{StaticResource RowText}"/>
              </StackPanel>
              <ComboBox Grid.Column="1" x:Name="StartPageBox" Style="{StaticResource Pick}" SelectionChanged="OnChanged" AutomationProperties.Name="Start page"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Start with the sidebar collapsed" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="Only the icons show; the button at the bottom of the sidebar opens it." Style="{StaticResource RowText}"/>
              </StackPanel>
              <CheckBox Grid.Column="1" x:Name="StartCollapsed" Style="{StaticResource Tick}" Checked="OnChanged" Unchecked="OnChanged"
                        AutomationProperties.Name="Start with the sidebar collapsed"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Your avatar" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="A random picture, or one of your own. Your picture stays on this PC; the launcher keeps a small square copy." Style="{StaticResource RowText}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl x:Name="AvatarPreview" Width="44" Height="44"/>
                <Button Style="{StaticResource Small}" Content="Upload picture" Click="OnUploadAvatar" Margin="14,0,0,0" AutomationProperties.Name="Upload picture"/>
                <Button Style="{StaticResource Small}" Content="Random" Click="OnNewAvatar" AutomationProperties.Name="New random avatar"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- ===== Builds ===== -->
        <StackPanel x:Name="PageBuilds" Visibility="Collapsed">
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Stop builds gently" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="STOP sends Ctrl+C first, so the build continues where it left off next time. Off: STOP ends it at once." Style="{StaticResource RowText}"/>
              </StackPanel>
              <CheckBox Grid.Column="1" x:Name="StopGracefully" Style="{StaticResource Tick}" Checked="OnChanged" Unchecked="OnChanged"
                        AutomationProperties.Name="Stop builds gently"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Time to stop" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="How long a gentle stop may take before the build is ended (5 to 600 seconds)." Style="{StaticResource RowText}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="GraceBox" Style="{StaticResource Field}" Width="70" TextAlignment="Right" TextChanged="OnChanged" AutomationProperties.Name="Time to stop"/>
                <TextBlock Text="seconds" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource SubText}"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Flash the taskbar" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="When a build ends while the launcher is in the background." Style="{StaticResource RowText}"/>
              </StackPanel>
              <CheckBox Grid.Column="1" x:Name="NotifyDone" Style="{StaticResource Tick}" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Flash the taskbar"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Play a sound" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="When a build ends." Style="{StaticResource RowText}"/>
              </StackPanel>
              <CheckBox Grid.Column="1" x:Name="SoundDone" Style="{StaticResource Tick}" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Play a sound"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Windows notification" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="When a build ends while the launcher is not in front: built, stopped or failed, and how long it took." Style="{StaticResource RowText}"/>
              </StackPanel>
              <CheckBox Grid.Column="1" x:Name="ToastDone" Style="{StaticResource Tick}" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Windows notification"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Keep running in the tray" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="Closing the window during a build (or while the port runs) keeps it going from the notification area. Off: closing asks to stop it." Style="{StaticResource RowText}"/>
              </StackPanel>
              <CheckBox Grid.Column="1" x:Name="CloseToTray" Style="{StaticResource Tick}" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Keep running in the tray"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource RowLeft}">
                  <TextBlock Text="Console text size" Style="{StaticResource RowTitle}"/>
                  <TextBlock Text="The build console on the BUILD tab." Style="{StaticResource RowText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Slider x:Name="FontSlider" Width="250" Minimum="10" Maximum="18" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnFont"
                          VerticalAlignment="Center" AutomationProperties.Name="Console text size"/>
                  <TextBlock x:Name="FontValue" Width="44" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Heading}"/>
                </StackPanel>
              </Grid>
              <Border Background="{StaticResource ConsoleBg}" Padding="12,8" Margin="0,14,0,0" CornerRadius="3">
                <TextBlock x:Name="FontPreview" Text="11:13:27  check: Xbox Series package 1.0.2.1, 108 files" Foreground="#D6D6D6" FontFamily="{StaticResource Mono}"/>
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Keep build logs" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="Older logs are deleted when the launcher starts. 0 keeps them all." Style="{StaticResource RowText}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="KeepLogsBox" Style="{StaticResource Field}" Width="70" TextAlignment="Right" TextChanged="OnChanged" AutomationProperties.Name="Keep build logs"/>
                <TextBlock Text="days" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource SubText}"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- ===== Online ===== -->
        <StackPanel x:Name="PageOnline" Visibility="Collapsed">
          <TextBlock Style="{StaticResource RowText}" Margin="0,6,0,6"
                     Text="The launcher goes online only for these three. Builds and Play never do."/>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="GitHub" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="Credits from api.github.com: everyone's commit count and profile picture, refreshed once a day." Style="{StaticResource RowText}"/>
                <TextBlock Text="Off: Credits uses your checkout's git history, without profile pictures." Style="{StaticResource RowText}"/>
              </StackPanel>
              <CheckBox Grid.Column="1" x:Name="AllowGitHub" Style="{StaticResource Tick}" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="GitHub"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Can I Run checker" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="The community checker page, run in the background to compare your PC with every console on its list." Style="{StaticResource RowText}"/>
                <TextBlock Text="Off: Can I Run Leonida shows only your hardware." Style="{StaticResource RowText}"/>
              </StackPanel>
              <CheckBox Grid.Column="1" x:Name="AllowChecker" Style="{StaticResource Tick}" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Can I Run checker"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Achievement list" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="GTA VI's achievements from github.com/Dom-in/Gta6AchivmentsList, downloaded when the launcher starts and kept for offline." Style="{StaticResource RowText}"/>
                <TextBlock Text="Off: the Achievements page shows the last list it downloaded." Style="{StaticResource RowText}"/>
              </StackPanel>
              <CheckBox Grid.Column="1" x:Name="AllowAchievements" Style="{StaticResource Tick}" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Achievement list"/>
            </Grid>
          </Border>
        </StackPanel>

        <!-- ===== About and files ===== -->
        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
          <Border Style="{StaticResource Row}">
            <StackPanel>
              <TextBlock Text="Version" Style="{StaticResource RowTitle}"/>
              <TextBlock x:Name="AboutVersion" Style="{StaticResource RowText}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Row}">
            <StackPanel>
              <TextBlock Text="Settings file" Style="{StaticResource RowTitle}"/>
              <TextBlock x:Name="SettingsPath" Style="{StaticResource RowText}" FontFamily="{StaticResource Mono}" FontSize="12"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Build logs" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="Each build's full output, kept for the days set in Builds." Style="{StaticResource RowText}"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource Small}" Content="Open logs folder" Click="OnLogs"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Restore defaults" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="Every launcher setting and build option goes back to its default. The build history and logs stay." Style="{StaticResource RowText}"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource Danger}" Content="Restore defaults" Click="OnReset" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </StackPanel>

        <!-- ===== Your setup ===== -->
        <StackPanel x:Name="PageSetup" Visibility="Collapsed">
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock x:Name="Summary" Style="{StaticResource RowTitle}" FontWeight="SemiBold"/>
                <TextBlock x:Name="ChecksNote" Style="{StaticResource RowText}"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource Small}" Content="Check again" Click="OnRefresh"/>
            </Grid>
          </Border>
          <ItemsControl x:Name="ToolList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" FontSize="16" Margin="0,2,14,0" VerticalAlignment="Top"
                               Text="{Binding Glyph}" Foreground="{Binding Color}"/>
                    <StackPanel>
                      <TextBlock Foreground="{DynamicResource Heading}" FontSize="14"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding For, Mode=OneWay}" Foreground="{DynamicResource Faint}" FontSize="11.5"/></TextBlock>
                      <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource SubText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      <TextBlock Text="{Binding Hint}" FontSize="12" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Visibility="{Binding HintVisibility}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="DiskText" FontSize="12.5" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SubText}"/>
        </StackPanel>

        <!-- ===== Play ===== -->
        <StackPanel x:Name="PagePlay" Visibility="Collapsed">
          <TextBlock Style="{StaticResource RowText}" Margin="0,6,0,6"
                     Text="PLAY runs gta6rt.exe --run on game_scarlett_master.exe from your copy (runtime/README.md)."/>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Overlay folder" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="--overlay: where whatever the title writes goes, so the package is never modified. Empty: &lt;game&gt;\overlay." Style="{StaticResource RowText}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="OverlayBox" Style="{StaticResource Field}" Width="300" TextChanged="OnPlayChanged" AutomationProperties.Name="Overlay folder"/>
                <Button Style="{StaticResource Small}" Content="Browse" Click="OnBrowseOverlay"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Mods folder" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="--mods: mods to load (docs/modding.md). Empty: the mods folder next to gta6rt.exe." Style="{StaticResource RowText}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="ModsBox" Style="{StaticResource Field}" Width="300" TextChanged="OnPlayChanged" AutomationProperties.Name="Mods folder"/>
                <Button Style="{StaticResource Small}" Content="Browse" Click="OnBrowseMods"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Vulkan D3D12 backend" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="LEONIDA_D3D12=vulkan" Style="{StaticResource RowText}" FontFamily="{StaticResource Mono}"/>
              </StackPanel>
              <CheckBox Grid.Column="1" x:Name="VulkanBackend" Style="{StaticResource Tick}" Checked="OnPlayChanged" Unchecked="OnPlayChanged" AutomationProperties.Name="Vulkan D3D12 backend"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Trace D3D12 calls" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="--trace-d3d12" Style="{StaticResource RowText}" FontFamily="{StaticResource Mono}"/>
              </StackPanel>
              <CheckBox Grid.Column="1" x:Name="TraceD3D12" Style="{StaticResource Tick}" Checked="OnPlayChanged" Unchecked="OnPlayChanged" AutomationProperties.Name="Trace D3D12 calls"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Startup trace file" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="--trace: a new file the runtime writes its start-up trace to." Style="{StaticResource RowText}"/>
              </StackPanel>
              <TextBox Grid.Column="1" x:Name="TraceFileBox" Style="{StaticResource Field}" Width="300" TextChanged="OnPlayChanged" AutomationProperties.Name="Startup trace file"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Game arguments" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="Passed to the title after --." Style="{StaticResource RowText}"/>
              </StackPanel>
              <TextBox Grid.Column="1" x:Name="GameArgsBox" Style="{StaticResource Field}" Width="300" TextChanged="OnPlayChanged" FontFamily="{StaticResource Mono}"
                       AutomationProperties.Name="Game arguments"/>
            </Grid>
          </Border>
        </StackPanel>

        <!-- ===== Folders and Python ===== -->
        <!-- ===== Disk space ===== -->
        <StackPanel x:Name="PageDisk" Visibility="Collapsed">
          <Border Style="{StaticResource Row}">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Measure again" Click="OnDiskRefresh" AutomationProperties.Name="Measure again" Width="164" Margin="0"/>
                <StackPanel>
                  <TextBlock x:Name="DiskDrive" Style="{StaticResource RowTitle}" FontWeight="SemiBold"/>
                  <TextBlock x:Name="DiskSummary" Style="{StaticResource RowText}"/>
                </StackPanel>
              </DockPanel>
              <!-- The drive: Leonida's part, everything else, free -->
              <Grid Height="10" Margin="0,14,0,0" Background="{DynamicResource CardAlt}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="BarLeonida" Width="0*"/>
                  <ColumnDefinition x:Name="BarOther" Width="0*"/>
                  <ColumnDefinition x:Name="BarFree" Width="1*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Fill="{StaticResource Sunset}"/>
                <Rectangle Grid.Column="1" Fill="{DynamicResource LineStrong}"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Rectangle Width="10" Height="10" Fill="{StaticResource Sunset}" VerticalAlignment="Center"/>
                <TextBlock Text="Leonida" Style="{StaticResource RowText}" Margin="6,0,18,0"/>
                <Rectangle Width="10" Height="10" Fill="{DynamicResource LineStrong}" VerticalAlignment="Center"/>
                <TextBlock Text="Everything else" Style="{StaticResource RowText}" Margin="6,0,18,0"/>
                <Rectangle Width="10" Height="10" Fill="{DynamicResource CardAlt}" Stroke="{DynamicResource Line}" VerticalAlignment="Center"/>
                <TextBlock Text="Free" Style="{StaticResource RowText}" Margin="6,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <ItemsControl x:Name="DiskList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,16">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="164"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="15" Foreground="{DynamicResource Heading}"/>
                      <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource SubText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource Faint}" FontFamily="{StaticResource Mono}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                      <TextBlock Text="{Binding Size}" FontFamily="{StaticResource DisplayBold}" FontSize="20" Foreground="{DynamicResource Heading}" HorizontalAlignment="Right"/>
                      <TextBlock Text="{Binding FileCount}" FontSize="11" Foreground="{DynamicResource Faint}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <!-- Same two slots on every row (Delete's stays empty for the port), so the buttons line up -->
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="8"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                      <Button Style="{StaticResource Small}" Margin="0" HorizontalAlignment="Stretch" Content="{Binding OpenText}" Click="OnDiskOpen" Tag="{Binding}"/>
                      <Button Grid.Column="2" Style="{StaticResource Small}" Margin="0" HorizontalAlignment="Stretch" Content="{Binding DeleteText}" Click="OnDiskDelete" Tag="{Binding}"
                              Visibility="{Binding DeleteVisibility}" IsEnabled="{Binding CanDelete}"/>
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource RowText}" Margin="0,14,0,0"
                     Text="Deleting here never touches your game copy, the port itself or anything outside these folders. While a build runs, nothing can be deleted."/>
        </StackPanel>

        <StackPanel x:Name="PageFolders" Visibility="Collapsed">
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Leonida folder" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="The folder with Build.bat. Found by itself when Leonida.exe is next to Build.bat." Style="{StaticResource RowText}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="RepoBox" Style="{StaticResource Field}" Width="300" IsReadOnly="True" Background="{DynamicResource CardAlt}" AutomationProperties.Name="Leonida folder"/>
                <Button Style="{StaticResource Small}" Content="Change" Click="OnChooseRepo"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Style="{StaticResource RowLeft}">
                <TextBlock Text="Python" Style="{StaticResource RowTitle}"/>
                <TextBlock x:Name="PythonText" Style="{StaticResource RowText}"/>
                <TextBlock Text="Empty: found as Build.bat finds it (py -3.14 … py -3, then python)." Style="{StaticResource RowText}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="PythonBox" Style="{StaticResource Field}" Width="300" AutomationProperties.Name="Python"/>
                <Button Style="{StaticResource Small}" Content="Browse" Click="OnBrowsePython"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <StackPanel>
              <TextBlock Text="Environment variables" Style="{StaticResource RowTitle}"/>
              <TextBlock Text="For builds and Play. One NAME=value per line, e.g. LLVM_MC=C:\path\to\llvm-mc.exe. A variable left out keeps the value Windows gives it." Style="{StaticResource RowText}"/>
              <TextBox x:Name="EnvBox" AcceptsReturn="True" Height="96" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource Mono}" FontSize="12"
                       AutomationProperties.Name="Environment variables"/>
            </StackPanel>
          </Border>
          <WrapPanel Margin="0,18,0,0"><Button Style="{StaticResource Dark}" Content="Apply and check again" Click="OnApply"/></WrapPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
