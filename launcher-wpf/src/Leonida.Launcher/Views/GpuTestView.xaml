<UserControl x:Class="Leonida.Launcher.Views.GpuTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="56,40,56,30">
    <StackPanel MaxWidth="1180">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
          <Button x:Name="StopButton" Style="{StaticResource Outline}" Content="Stop" Click="OnStop" Padding="18,9" Margin="0,0,12,0" Visibility="Collapsed"/>
          <Button x:Name="RunButton" Style="{StaticResource Bevel}" Content="RUN THE TESTS" Click="OnRun" Height="50" MinWidth="220" FontSize="20"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="GPU TESTS" Style="{StaticResource H1}"/>
          <Rectangle Height="4" Width="96" Fill="{StaticResource Sunset}" HorizontalAlignment="Left" Margin="0,2,0,0"/>
          <TextBlock FontSize="13" Foreground="{DynamicResource SubText}" TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="640" HorizontalAlignment="Left"
                     Text="Runs the repository's GPU test suite (scripts/run_gpu_tests.py) on your graphics card and writes the result the way the coordination issue asks for it. No game files are used."/>
        </StackPanel>
      </DockPanel>

      <!-- This PC and the test programs -->
      <Border Style="{StaticResource Card}" Margin="0,22,0,16">
        <Grid Margin="20,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="GRAPHICS CARD" Style="{StaticResource Label}"/>
            <TextBlock x:Name="GpuName" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Heading}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="GpuMore" FontSize="12" Foreground="{DynamicResource SubText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="TEST PROGRAMS" Style="{StaticResource Label}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Outline}" Content="Browse" Click="OnBrowse" Padding="12,6" Margin="8,0,0,0"/>
              <TextBox x:Name="ProgramsBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" TextChanged="OnProgramsChanged" AutomationProperties.Name="Test programs folder"/>
            </DockPanel>
            <TextBlock x:Name="ProgramsNote" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <DockPanel Margin="0,0,0,14">
        <TextBlock Text="Only tests whose name has:" VerticalAlignment="Center" Foreground="{DynamicResource SubText}"/>
        <TextBox x:Name="FilterBox" Width="220" Height="32" Margin="10,0,0,0" VerticalContentAlignment="Center" Padding="8,0" AutomationProperties.Name="Filter"/>
        <TextBlock Text="(empty: all)" VerticalAlignment="Center" Foreground="{DynamicResource Faint}" Margin="10,0,0,0"/>
        <TextBlock x:Name="Commit" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Faint}" FontFamily="{StaticResource Mono}" FontSize="12"/>
      </DockPanel>

      <!-- The result -->
      <Border x:Name="ResultCard" Style="{StaticResource Card}" Visibility="Collapsed">
        <DockPanel>
          <Border DockPanel.Dock="Top" Style="{StaticResource Caption}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <RadioButton x:Name="ShowAll" Content="All" GroupName="gpufilter" Foreground="#FFFFFF" IsChecked="True" Checked="OnShowFilter" Margin="0,0,14,0"/>
                <RadioButton x:Name="ShowFailed" Content="Failed" GroupName="gpufilter" Foreground="#FFFFFF" Checked="OnShowFilter"/>
              </StackPanel>
              <TextBlock x:Name="ResultTitle" Style="{StaticResource CaptionText}"/>
            </DockPanel>
          </Border>
          <StackPanel>
            <UniformGrid Columns="4" Margin="20,14,20,10">
              <StackPanel><TextBlock x:Name="NPass" FontFamily="{StaticResource DisplayBold}" FontSize="30" Foreground="{StaticResource Ok}"/><TextBlock Text="PASSED" Style="{StaticResource Label}"/></StackPanel>
              <StackPanel><TextBlock x:Name="NFail" FontFamily="{StaticResource DisplayBold}" FontSize="30" Foreground="{StaticResource Bad}"/><TextBlock Text="FAILED" Style="{StaticResource Label}"/></StackPanel>
              <StackPanel><TextBlock x:Name="NSkip" FontFamily="{StaticResource DisplayBold}" FontSize="30" Foreground="{DynamicResource Muted}"/><TextBlock Text="SKIPPED" Style="{StaticResource Label}"/></StackPanel>
              <StackPanel><TextBlock x:Name="NTime" FontFamily="{StaticResource DisplayBold}" FontSize="30" Foreground="{DynamicResource Heading}"/><TextBlock Text="TIME" Style="{StaticResource Label}"/></StackPanel>
            </UniformGrid>
            <ItemsControl x:Name="Results" Margin="0,0,0,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,7">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="46" CornerRadius="2" Background="{Binding TagBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Tag}" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2"/>
                      </Border>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="230" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource Heading}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource SubText}" TextWrapping="Wrap"/>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- The report to post -->
      <Border x:Name="ReportCard" Style="{StaticResource Card}" Visibility="Collapsed">
        <DockPanel>
          <Border DockPanel.Dock="Top" Style="{StaticResource Caption}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Copy" Click="OnCopy" Foreground="#FFFFFF" Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
              <TextBlock Text="Your report" Style="{StaticResource CaptionText}"/>
            </DockPanel>
          </Border>
          <StackPanel Margin="20,12,20,16">
            <TextBlock FontSize="12.5" Foreground="{DynamicResource SubText}" TextWrapping="Wrap"
                       Text="Paste it on the pull request you tested, or in the coordination issue. It has the commit, your card, driver and Windows version, and the counts; no folder of yours."/>
            <TextBox x:Name="ReportBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,10,0,0"
                     MinHeight="90" VerticalScrollBarVisibility="Auto" MaxHeight="220"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- What the suite prints -->
      <Expander x:Name="OutputExpander" Header="Output" Margin="0,4,0,0">
        <Border Background="{StaticResource ConsoleBg}" Padding="12,8" Margin="0,8,0,0">
          <TextBox x:Name="Output" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#D6D6D6" FontFamily="{StaticResource Mono}" FontSize="11.5"
                   Height="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CaretBrush="#D6D6D6"/>
        </Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
